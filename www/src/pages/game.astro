---
const title = "htmx gameboy";
---

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no" />
    <title>{title}</title>
    <style>
        :root {
            --page-bg: #8e8a82;
            --shell: #dcd7cc;
            --shell-edge: #b6b0a3;
            --bezel: #4a4854;
            --screen: #9bbc0f;
            --accent: #8b1e57;
            --ink: #2a2834;
        }

        * { box-sizing: border-box; }

        html, body {
            margin: 0;
            padding: 0;
            min-height: 100%;
            background: var(--page-bg);
            color: var(--ink);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            -webkit-user-select: none;
            user-select: none;
            -webkit-touch-callout: none;
            touch-action: manipulation;
        }

        a { color: inherit; }

        #back-nav {
            position: fixed;
            top: 14px;
            left: 14px;
            font-size: 12px;
            color: #5a5750;
            text-decoration: none;
            padding: 5px 10px;
            border: 1px solid #8a857c;
            border-radius: 3px;
            background: rgba(255,255,255,0.15);
            z-index: 100;
        }
        #back-nav:hover { color: var(--ink); border-color: var(--ink); }

        #page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px 16px;
        }
        .row {
            position: relative;
            width: min(440px, 94vw);
        }

        /* ============ CHASSIS ============ */
        .gameboy {
            width: min(440px, 94vw);
            background: var(--shell);
            border-radius: 8px 8px 48px 8px;
            padding: 22px 22px 28px;
            border: 1px solid var(--shell-edge);
            position: relative;
        }

        /* keyboard help card (outside the chassis) */
        .keyboard-help {
            position: absolute;
            top: 0;
            left: calc(100% + 20px);
            background: var(--shell);
            border: 1px solid var(--shell-edge);
            border-radius: 6px;
            padding: 12px 14px;
            font-size: 10px;
            line-height: 1.5;
            color: #5a5750;
            min-width: 150px;
        }
        .keyboard-help h2 {
            margin: 0 0 8px;
            font-size: 9px;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: #7a7568;
            font-weight: 700;
        }
        .keyboard-help dl {
            display: grid;
            grid-template-columns: auto 1fr;
            gap: 4px 12px;
            margin: 0;
        }
        .keyboard-help dt { color: #5a5750; font-weight: 500; }
        .keyboard-help dd { margin: 0; color: var(--ink); font-weight: 600; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 10px; }

        /* brand strip inside the bezel */
        .bezel-brand {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            align-items: center;
            gap: 10px;
            margin-bottom: 10px;
            text-align: center;
        }
        .bezel-brand .stripes {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }
        .bezel-brand .stripes span {
            display: block;
            height: 2px;
            border-radius: 1px;
        }
        .bezel-brand .stripes .red { background: #e05a6a; }
        .bezel-brand .stripes .blue { background: #7a8fe8; }
        .bezel-brand .word {
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.02em;
            color: #d9d5d0;
            white-space: nowrap;
        }

        /* sound toggle in lower-left of chassis */
        .sound-toggle {
            position: absolute;
            bottom: 22px;
            left: 22px;
            width: 30px;
            height: 30px;
            border-radius: 3px;
            background: var(--shell);
            border: 1px solid #8a857c;
            color: #5a5750;
            cursor: pointer;
            padding: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 2px 0 rgba(0,0,0,0.18);
            transition: color 80ms, border-color 80ms, transform 80ms, box-shadow 80ms;
        }
        .sound-toggle:hover { color: var(--ink); border-color: var(--ink); }
        .sound-toggle:active { transform: translateY(2px); box-shadow: 0 0 0 rgba(0,0,0,0); }
        .sound-toggle svg { display: block; width: 14px; height: 14px; }
        .sound-toggle .icon-off { display: none; }
        .sound-toggle[data-on="false"] .icon-on { display: none; }
        .sound-toggle[data-on="false"] .icon-off { display: block; }

        /* screen bezel */
        .gb-bezel {
            background: var(--bezel);
            border-radius: 4px 4px 28px 4px;
            padding: 24px 24px 28px;
        }
        .gb-screen {
            background: var(--screen);
            aspect-ratio: 10 / 9;
            overflow: hidden;
            box-shadow:
                inset 0 2px 4px rgba(0,0,0,0.45),
                inset 0 0 0 1px rgba(0,0,0,0.3);
            position: relative;
        }
        .gb-screen::after {
            content: "";
            position: absolute;
            inset: 0;
            pointer-events: none;
            box-shadow: inset 0 -1px 2px rgba(255,255,255,0.15);
        }
        .gb-screen canvas {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: contain;
            image-rendering: pixelated;
            image-rendering: crisp-edges;
        }

        /* controls */
        .gb-controls {
            margin-top: 28px;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        /* D-pad */
        .dpad {
            position: relative;
            width: 104px;
            height: 104px;
        }
        .dpad-btn {
            position: absolute;
            background: var(--ink);
            cursor: pointer;
            touch-action: none;
            transition: opacity 80ms, transform 80ms;
            box-shadow: 0 1px 0 rgba(0,0,0,0.15);
        }
        .dpad-btn.pressed { opacity: 0.85; transform: translateY(1px); box-shadow: none; }
        .dpad-up, .dpad-down { left: 36px; width: 32px; height: 36px; }
        .dpad-left, .dpad-right { top: 36px; width: 36px; height: 32px; }
        .dpad-up { top: 0; }
        .dpad-down { top: 68px; }
        .dpad-left { left: 0; }
        .dpad-right { left: 68px; }
        .dpad::after {
            content: "";
            position: absolute;
            top: 36px; left: 36px; width: 32px; height: 32px;
            background: var(--ink);
            pointer-events: none;
        }

        /* A/B buttons */
        .ab-buttons {
            position: relative;
            width: 132px;
            height: 104px;
        }
        .round-btn {
            position: absolute;
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: var(--accent);
            color: rgba(255,255,255,0.9);
            font-weight: 700;
            font-size: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            touch-action: none;
            user-select: none;
            border: none;
            box-shadow: 0 2px 0 rgba(0,0,0,0.18);
            transition: opacity 80ms, transform 80ms, box-shadow 80ms;
        }
        .round-btn.pressed { opacity: 0.9; transform: translateY(2px); box-shadow: 0 0 0 rgba(0,0,0,0); }
        .btn-b { top: 20px; left: 0; }
        .btn-a { top: 0; left: 64px; }

        /* Start/Select */
        .ss-buttons {
            margin-top: 18px;
            display: flex;
            justify-content: center;
            gap: 24px;
        }
        .ss-pair { display: flex; flex-direction: column; align-items: center; gap: 4px; }
        .capsule-btn {
            width: 62px;
            height: 20px;
            border-radius: 10px;
            background: var(--ink);
            cursor: pointer;
            touch-action: none;
            box-shadow: 0 2px 0 rgba(0,0,0,0.18);
            transition: opacity 80ms, transform 80ms, box-shadow 80ms;
        }
        .capsule-btn.pressed { opacity: 0.9; transform: translateY(2px); box-shadow: 0 0 0 rgba(0,0,0,0); }
        .capsule-label {
            font-size: 9px;
            font-weight: 600;
            color: #5a5750;
            letter-spacing: 0.12em;
        }

        /* ============ MOBILE LAYOUT ============ */
        @media (max-width: 720px) {
            #page { padding: 12px 10px; }
            .row { width: 100%; max-width: 480px; display: flex; flex-direction: column; align-items: center; gap: 10px; }
            .gameboy { width: 100%; max-width: 480px; }
            .gb-bezel { padding: 16px 18px 20px; }
            .keyboard-help {
                position: static;
                order: -1;
                width: 100%;
                max-width: 480px;
                padding: 6px 10px;
                min-width: 0;
            }
            .keyboard-help h2 { display: none; }
            .keyboard-help dl {
                display: block;
                text-align: center;
                line-height: 1.6;
            }
            .keyboard-help dt { display: inline; font-size: 10px; color: #7a7568; }
            .keyboard-help dd { display: inline; font-size: 10px; margin: 0 12px 0 4px; }
        }

        /* hide the emulator's built-in touch controller */
        #controller { display: none !important; }
    </style>
</head>
<body>
    <a id="back-nav" href="/">← back</a>

    <div id="page">
    <div class="row">
        <div class="gameboy">
            <div class="gb-bezel">
                <div class="bezel-brand">
                    <div class="stripes"><span class="red"></span><span class="blue"></span></div>
                    <div class="word">htmx</div>
                    <div class="stripes"><span class="red"></span><span class="blue"></span></div>
                </div>
                <div class="gb-screen">
                    <canvas id="mainCanvas" width="256" height="224">No Canvas Support</canvas>
                </div>
            </div>

            <button type="button" class="sound-toggle" id="sound-toggle" data-on="true" aria-label="Toggle sound">
                <svg class="icon-on" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 6v4h2.5L9 13V3L5.5 6H3z" fill="currentColor" stroke="none"/>
                    <path d="M11 5.5c.8.6 1.3 1.5 1.3 2.5s-.5 1.9-1.3 2.5"/>
                    <path d="M13 3.5c1.5 1.1 2.5 2.7 2.5 4.5s-1 3.4-2.5 4.5"/>
                </svg>
                <svg class="icon-off" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 6v4h2.5L9 13V3L5.5 6H3z" fill="currentColor" stroke="none"/>
                    <path d="M11.5 6l3 4M14.5 6l-3 4"/>
                </svg>
            </button>

            <div class="gb-controls">
                <div class="dpad">
                    <div class="dpad-btn dpad-up" data-gb-btn="up"></div>
                    <div class="dpad-btn dpad-down" data-gb-btn="down"></div>
                    <div class="dpad-btn dpad-left" data-gb-btn="left"></div>
                    <div class="dpad-btn dpad-right" data-gb-btn="right"></div>
                </div>
                <div class="ab-buttons">
                    <div class="round-btn btn-b" data-gb-btn="b">B</div>
                    <div class="round-btn btn-a" data-gb-btn="a">A</div>
                </div>
            </div>

            <div class="ss-buttons">
                <div class="ss-pair">
                    <div class="capsule-btn" data-gb-btn="select"></div>
                    <div class="capsule-label">SELECT</div>
                </div>
                <div class="ss-pair">
                    <div class="capsule-btn" data-gb-btn="start"></div>
                    <div class="capsule-label">START</div>
                </div>
            </div>
        </div>

        <aside class="keyboard-help">
            <h2>Keyboard</h2>
            <dl>
                <dt>D-pad</dt><dd>↑ ↓ ← →</dd>
                <dt>A</dt><dd>Z</dd>
                <dt>B</dt><dd>X</dd>
                <dt>Start</dt><dd>Enter</dd>
                <dt>Select</dt><dd>Shift</dd>
            </dl>
        </aside>
    </div>
    </div>

    <!-- hidden stubs required by the emulator's onscreen-controller binding -->
    <div id="controller" aria-hidden="true" style="display:none">
        <div id="controller_dpad"></div>
        <div id="controller_select"></div>
        <div id="controller_start"></div>
        <div id="controller_b"></div>
        <div id="controller_a"></div>
    </div>

    <script is:inline>
        window.customControls = {
            up: ["ArrowUp", "w"],
            down: ["ArrowDown", "s"],
            left: ["ArrowLeft", "a"],
            right: ["ArrowRight", "d"],
            a: ["z", "j"],
            b: ["x", "k"],
            start: ["Enter"],
            select: ["Shift"]
        };

        const BTN_METHODS = {
            up: "setJoypUp", down: "setJoypDown", left: "setJoypLeft", right: "setJoypRight",
            a: "setJoypA", b: "setJoypB", start: "setJoypStart", select: "setJoypSelect"
        };
        function setJoyp(btn, down) {
            const emu = window.gbEmulator;
            const fn = emu && BTN_METHODS[btn];
            if (emu && fn) emu[fn](down);
        }

        // Sound toggle (persisted in localStorage)
        (function () {
            const btn = document.getElementById("sound-toggle");
            if (!btn) return;
            const STORE_KEY = "htmxgb:soundOn";
            const DEFAULT_VOLUME = 0.5;
            let soundOn = localStorage.getItem(STORE_KEY) !== "false"; // default ON

            function apply() {
                if (window.vm) window.vm.volume = soundOn ? DEFAULT_VOLUME : 0;
                const ctx = window.gbAudioCtx;
                if (ctx) {
                    if (soundOn) { if (ctx.state === "suspended") ctx.resume(); }
                    else { if (ctx.state === "running") ctx.suspend(); }
                }
                btn.setAttribute("data-on", soundOn ? "true" : "false");
                btn.setAttribute("aria-label", soundOn ? "Sound on" : "Sound off");
            }

            // Wait for vm (the emulator script sets window.vm on init).
            function waitForVm() {
                if (window.vm) { apply(); return; }
                setTimeout(waitForVm, 50);
            }
            waitForVm();
            apply(); // update button label immediately

            btn.addEventListener("click", function () {
                soundOn = !soundOn;
                localStorage.setItem(STORE_KEY, soundOn ? "true" : "false");
                apply();
            });
        })();

        // Pause emulator while the tab is hidden — prevents a glitchy
        // catch-up frame when rAF resumes after tab throttling.
        document.addEventListener("visibilitychange", function () {
            if (!window.vm) return;
            window.vm.paused = document.hidden;
        });

        document.querySelectorAll("[data-gb-btn]").forEach(function (el) {
            const btn = el.getAttribute("data-gb-btn");
            let active = false;
            const press = function (e) {
                if (active) return;
                active = true;
                el.classList.add("pressed");
                setJoyp(btn, true);
                if (e.pointerId !== undefined) {
                    try { el.setPointerCapture(e.pointerId); } catch (_) {}
                }
                e.preventDefault();
            };
            const release = function (e) {
                if (!active) return;
                active = false;
                el.classList.remove("pressed");
                setJoyp(btn, false);
                if (e && e.preventDefault) e.preventDefault();
            };
            el.addEventListener("pointerdown", press);
            el.addEventListener("pointerup", release);
            el.addEventListener("pointercancel", release);
            el.addEventListener("pointerleave", release);
        });
    </script>
    <script is:inline src="/htmxgb/binjgb.js"></script>
    <script is:inline src="/htmxgb/js/script.js"></script>
</body>
</html>
