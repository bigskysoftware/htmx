---
import CDNSnippet from "./CDNSnippet.astro";
import HeroStats from "./HeroStats.astro";
---

<section id="hero"
         _="on intersection(intersecting) having threshold 0.8
            if intersecting
                remove .grid-dimmed from #background-grid
            else
                add .grid-dimmed to #background-grid">
    <div class="hero-inner">

        <div class="logo-line">
            <h1 id="hero-logo">&lt;<em class="slash">/</em>&gt; <span class="wordmark">htm<em>x</em></span></h1>
            <p>Supercharged<svg class="bolt" viewBox="0 0 24 24" aria-hidden="true"
                                 ><path d="M11 2 L4 13 h7 l-4 9 L20 10 h-7 L20 2 z"/></svg>HTML</p>
        </div>

        <div class="sub">
            <CDNSnippet/>
            <HeroStats/>
        </div>

    </div>
</section>

<style>
    section {
        padding: 1.5rem 0 0.25rem;
        width: 100vw;
        position: relative;
        left: 50%;
        margin-left: -50vw;

        @media (min-width: 640px) { padding-top: 3rem; padding-bottom: 0.5rem; }
    }

    .hero-inner {
        max-width: 80rem;
        margin-inline: auto;
        padding-inline: 1rem;
        text-align: center;
        transform: translateZ(0);
        isolation: isolate;

        @media (min-width: 640px) { padding-inline: 1.5rem; }
        @media (min-width: 1024px) { padding-inline: 2rem; }
    }

    .logo-line {
        text-align: center;
    }

    h1 {
        /* Mobile shows only "</>", so it can carry the full width. The min()
           keeps it inside the viewport below ~350px. */
        font-size: min(10.5rem, 48vw);
        font-weight: 700;
        line-height: 1;
        font-family: var(--font-chicago);
        letter-spacing: var(--tracking-tightest);
        color: light-dark(black, white);
        transform: translateZ(0);

        @media (min-width: 640px) { font-size: 5rem; letter-spacing: var(--tracking-tight); }
        @media (min-width: 1024px) { font-size: 6.25rem; }

        .wordmark {
            @media (max-width: 639px) { display: none; }
        }

        /* ChicagoFLF draws the solidus at 77/1000em thick but the chevrons at
           122/1000em. The stroke adds the 45/1000em difference. */
        em.slash {
            -webkit-text-stroke: 0.045em currentColor;
        }

        em {
            font-style: normal;
            color: light-dark(var(--color-blue-600), var(--color-blue-350));
            text-shadow:
                0 2px 0 color-mix(in srgb, var(--color-blue-900) 95%, white),
                0 4px 0 color-mix(in srgb, var(--color-blue-900) 95%, black);

            @media (prefers-color-scheme: dark) {
                text-shadow:
                    0 2px 0 color-mix(in srgb, var(--color-blue-700) 95%, white),
                    0 4px 0 color-mix(in srgb, var(--color-blue-700) 95%, black);
            }
        }
    }

    .logo-line p {
        margin-top: 0.5rem;
        font-style: italic;
        font-weight: 300;
        font-size: min(2.1rem, 9.5vw);

        @media (min-width: 640px) { margin-top: 0.75rem; font-size: 1.125rem; }
        @media (min-width: 1024px) { font-size: 1.25rem; }
    }

    /* Tailwind only emits the yellow vars it sees in classes, so use literals. */
    .bolt {
        display: inline-block;
        height: 0.95em;
        width: auto;
        margin-inline: 0.12em;
        vertical-align: -0.14em;
        fill: light-dark(#eab308, #facc15);
    }


    .sub {
        margin-top: 2.25rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.5rem;

        @media (min-width: 640px) { margin-top: 3.25rem; gap: 2.25rem; }
    }
</style>
