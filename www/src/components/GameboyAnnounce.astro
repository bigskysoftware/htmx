---
// Home-page launch announcement, rendered just above the Hero.
// The whole banner is a clickable, pressable button (styled after the site's
// .cta). "Game Boy" uses a heavy italic sans (var(--font-sans), weight 900) in
// white; the "Color" word uses Comic Sans with a bright per-letter palette.
// A playful lookalike for the trademarked logotypes, not a copy.
//
const href = 'https://swag.htmx.org/products/htmx-4-the-game';
const colorPalette = ['#ff6ec7', '#c9a3ff', '#ffd93b', '#8be04e', '#35e0c8'];
const colorLetters = 'Color'.split('').map((ch, i) => ({ ch, color: colorPalette[i % colorPalette.length] }));
---
<div class="not-prose max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 mt-8 sm:mt-10">
    <a
        href={href}
        class="gb-btn flex items-center justify-center gap-4 rounded-xl px-8 py-4 w-fit mx-auto
               text-center text-base sm:text-xl tracking-tight font-semibold text-white"
    >
        <i class="icon-[mdi--gamepad-variant] size-12 opacity-80 shrink-0" aria-hidden="true"></i>
        <span class="flex flex-col items-center gap-1">
            <span>
                <span class="font-chicago">htmx 4.0</span> has launched exclusively for <br/>
                <span class="gb-logo gb-blue">Game Boy<sup class="tm">&trade;</sup></span>
                &amp;
                <span class="gb-logo gb-blue">Game Boy</span><span class="gb-color">{colorLetters.map((l) => <span style={`color:${l.color}`}>{l.ch}</span>)}</span><sup class="tm">&trade;</sup>!
            </span>
            <span class="buy-chip font-chicago">Buy Now!</span>
        </span>
    </a>
</div>

<style>
    /* heavy oblique caps sans for "GAME BOY" — evokes the wordmark, not the logo font */
    .gb-logo {
        font-family: var(--font-sans);
        font-weight: 900;
        font-style: italic;
        font-size: 0.9em;
        text-transform: uppercase;
        letter-spacing: -0.03em;
        white-space: nowrap;
    }
    /* "Game Boy" is white so it reads on the blue button */
    .gb-blue {
        color: #fff;
    }
    /* bubbly "Color" wordmark */
    .gb-color {
        font-family: 'Comic Sans MS', 'Comic Sans', 'Chalkboard SE', 'Comic Neue', cursive;
        font-weight: 700;
        font-size: 0.92em;
        margin-left: 0.2em;
        white-space: nowrap;
    }
    .tm {
        font-size: 0.5em;
        vertical-align: super;
    }
    /* the actual call-to-action pill */
    .buy-chip {
        display: inline-block;
        padding: 0.35em 1.1em;
        font-size: 1.7em;
        line-height: 1;
    }

    /* filled, 3D-pressable button — echoes the site's .cta */
    .gb-btn {
        text-decoration: none;
        cursor: pointer;
        color: #fff;
        background: linear-gradient(to bottom,
            var(--color-blue-500, #3b82f6),
            var(--color-blue-700, #1d4ed8));
        border: 1px solid var(--color-blue-400, #60a5fa);
        box-shadow:
            0 5px 0 var(--color-blue-800, #1e40af),
            0 12px 22px rgba(0, 0, 0, 0.35);
        transition: transform 0.12s ease, box-shadow 0.12s ease, filter 0.15s ease;
    }
    @media (hover: hover) {
        .gb-btn:hover { filter: brightness(1.08); }
    }
    .gb-btn:active {
        transform: translateY(4px);
        box-shadow:
            0 1px 0 var(--color-blue-800, #1e40af),
            0 4px 10px rgba(0, 0, 0, 0.3);
    }
    .gb-btn:focus-visible {
        outline: 2px solid var(--color-blue-500, #3b82f6);
        outline-offset: 3px;
    }
</style>
