---
/**
 * The left rail: the contents of the current page.
 *
 * `html` comes from resolvePageNav(). It is either derived from the page
 * headings or an authored file, and both arrive as the same nested list, so
 * one stylesheet covers both.
 */
interface Props {
    html: string;
    id: string;
}

const {html, id} = Astro.props;
---

<nav {id}
     data-page-nav
     aria-label="On this page"
     _="install Scrollspy"
     set:html={html}></nav>

<style is:global>
    /* Global, not scoped: set:html content carries no data-astro-cid
       attribute, so a scoped rule would never reach the injected markup. */
    [data-page-nav] {
        font-size: 0.875rem;

        ul {
            list-style: none;
            margin: 0;
            padding: 0;
            border-left: 1px solid light-dark(var(--color-neutral-200), var(--color-neutral-800));
        }

        ul ul {
            margin-left: 1rem;
        }

        /* Sub-item names are long and the rail is 15rem. Below the section
           level, wrap rather than truncate so the name stays readable. */
        ul ul ul {
            margin-left: 0.75rem;

            a {
                white-space: normal;
                text-overflow: clip;
                line-height: 1.3;
            }
        }

        a, span {
            display: block;
            padding: 0.375rem 0.5rem 0.375rem 1rem;
            margin-left: -1px;
            border-left: 2px solid transparent;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        /* A bare span is a group label in an authored nav. */
        span {
            color: light-dark(var(--color-neutral-500), var(--color-neutral-450));
            font-family: var(--font-chicago);
            font-size: 0.6875rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        a {
            color: light-dark(var(--color-neutral-600), var(--color-neutral-400));
            text-decoration: none;

            @media (hover: hover) {
                &:hover {
                    color: light-dark(var(--color-neutral-900), var(--color-neutral-200));
                    border-left-color: light-dark(var(--color-neutral-300), var(--color-neutral-700));
                }
            }

            &:is(:focus-visible, :active) {
                color: light-dark(var(--color-neutral-900), var(--color-neutral-200));
                border-left-color: light-dark(var(--color-neutral-300), var(--color-neutral-700));
            }

            &[aria-current] {
                font-weight: 600;
                color: light-dark(var(--color-neutral-900), var(--color-neutral-100));
                border-left-color: light-dark(var(--color-neutral-900), var(--color-neutral-100));
            }
        }
    }
</style>
